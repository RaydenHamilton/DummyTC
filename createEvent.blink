-- these can be ignored if you are using the studio plugin
option ClientOutput = "blink/client.luau"
option ServerOutput = "blink/server.luau"

event PlaceBuild{
    from: Client,
    type: Reliable,
    call: SingleSync,
    data: (CFrame,string)
}

event RemoveBuild{
    from: Client,
    type: Reliable,
    call: SingleSync,
    data: (Instance(BasePart))
}

event GiveClientData{
    from: Server,
    type: Reliable,
    call: SingleSync,
    data: ()
}
