-- these can be ignored if you are using the studio plugin
option ClientOutput = "blink/client.luau"
option ServerOutput = "blink/server.luau"

event PlaceBuild{
    from: Client,
    type: Reliable,
    call: SingleSync,
    data: (CFrame,string)
}

event RemoveBuild{
    from: Client,
    type: Reliable,
    call: SingleSync,
    data: Instance(BasePart)
}

event SetClientData{
    from: Server,
    type: Reliable,
    call: ManySync,
    data: string
}

event SendRequestForDummyData{
    from: Client,
    type: Reliable,
    call: ManySync,
    data: string
}

event RespondRequestToClientRequestForDummyData{
    from: Server,
    type: Reliable, 
    call: ManySync, 
    data: (string,buffer)
}

event BuyDummyPart{
    from: Client,
    type: Reliable,
    call: SingleSync,
    data: (string,string)
}

